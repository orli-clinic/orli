{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orli",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  // Static files are served first; only paths with no matching file (the two
  // /api/* routes) reach worker.js. Secrets: see the header of worker.js.
  "main": "worker.js",
  "assets": {
    "directory": ".",
    // Lets worker.js fetch 404.html for paths that match no file.
    "binding": "ASSETS"
  },
  "vars": {
    "SLACK_CHANNEL_ID": "C0BV9BP95T3"
  },
  // Preview builds (one Worker per branch, `wrangler preview`) get no Slack
  // channel, so a form sent from a preview link never reaches the real one:
  // worker.js skips the post when SLACK_CHANNEL_ID is empty.
  "previews": {
    "vars": {
      "SLACK_CHANNEL_ID": ""
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
